---
import { Calendar, Flame } from '@lucide/astro';
import type { CalendarActivityEvent } from '@/lib/activity';
import MiniCalendar from './MiniCalendar.astro';

interface Props {
  /**
   * 真实活动事件（构建期由 src/lib/activity.ts 从操作日志 + Git 提交历史恢复）。
   * 只包含「已公开」笔记的活动，避免私有笔记标题出现在公开页面上。
   */
  activity: CalendarActivityEvent[];
}

const { activity } = Astro.props;

/**
 * 把事件内嵌为 JSON 供浏览器渲染。
 * 事件只带绝对时刻（ISO 8601），具体落在哪一天由浏览器按本地时区换算，
 * 因此这里不需要、也不应该做任何按日期的预处理。
 * 转义 `<` 以避免 `</script>` 提前闭合。
 */
const payload = JSON.stringify({ events: activity }).replace(/</g, '\\u003c');
---

<div class="kw-card kw-today-card" data-kw-calendar>
  <div class="kw-card-head">
    <span class="kw-card-icon"><Calendar size={15} /></span>
    <h3 class="kw-card-title">今日知识日历</h3>
  </div>

  <div class="kw-today-date">
    <div class="kw-date-main">
      <span class="kw-date-day" data-kw-today-date>—</span>
      <span class="kw-date-week" data-kw-today-week>—</span>
    </div>
    <div class="kw-streak">
      <Flame size={13} aria-hidden="true" />
      <span data-kw-streak>连续 0 天</span>
    </div>
  </div>

  <div class="kw-today-stats">
    <div class="kw-stat-item">
      <span class="kw-stat-num" data-kw-stat-today>0</span>
      <span class="kw-stat-label">今日笔记</span>
    </div>
    <div class="kw-stat-divider"></div>
    <div class="kw-stat-item">
      <span class="kw-stat-num" data-kw-stat-week>0</span>
      <span class="kw-stat-label">本周整理</span>
    </div>
    <div class="kw-stat-divider"></div>
    <div class="kw-stat-item">
      <span class="kw-stat-num" data-kw-stat-streak>0</span>
      <span class="kw-stat-label">连续天数</span>
    </div>
  </div>

  <MiniCalendar />

  <script type="application/json" data-kw-activity set:html={payload}></script>
</div>

<script>
  import { mountKnowledgeCalendar } from '@/scripts/knowledge-calendar';

  mountKnowledgeCalendar();
</script>

<style>
  .kw-today-card {
    display: flex;
    flex-direction: column;
  }

  .kw-today-date {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--kb-border-subtle);
  }

  .kw-date-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .kw-date-day {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--kb-heading);
    font-variant-numeric: tabular-nums;
  }

  .kw-date-week {
    font-size: 0.7rem;
    color: var(--kb-subtle);
  }

  .kw-streak {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--kb-accent) 12%, transparent);
    color: var(--kb-accent);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .kw-today-stats {
    display: flex;
    align-items: center;
    margin-top: 12px;
    padding-bottom: 4px;
  }

  .kw-stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .kw-stat-num {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--kb-heading);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .kw-stat-label {
    font-size: 0.66rem;
    color: var(--kb-subtle);
  }

  .kw-stat-divider {
    width: 1px;
    height: 22px;
    background: var(--kb-border-subtle);
  }
</style>
