---
import { ChevronRight, Clock } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { categoryMeta, displayTitle, docUrl, sortDocsByUpdated } from '@/lib/navigation';

interface Props {
  notes: CollectionEntry<'docs'>[];
}

const { notes } = Astro.props;

const accentColorMap: Record<string, string> = {
  orange: 'kw-tag-orange',
  green: 'kw-tag-green',
  blue: 'kw-tag-blue',
  amber: 'kw-tag-amber',
};

const categoryAccentMap: Record<string, string> = {
  mtk: 'blue',
  gms: 'blue',
  camera: 'amber',
  audio: 'green',
  display: 'orange',
  tools: 'orange',
};

const recent = sortDocsByUpdated(notes).slice(0, 4).map((doc) => {
  const d = doc.data.updated;
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  let time: string;
  if (diffDays === 0) {
    time = `今天 ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  } else if (diffDays === 1) {
    time = `昨天 ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  } else {
    time = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }
  return {
    id: doc.id,
    title: displayTitle(doc.data.title),
    time,
    category: categoryMeta[doc.data.category]?.title ?? doc.data.category,
    categoryColor: (categoryAccentMap[doc.data.category] || 'slate') as 'orange' | 'green' | 'blue' | 'amber',
    href: docUrl(doc.id),
  };
});
---

<div class="kw-card kw-recent-card">
  <div class="kw-card-head">
    <span class="kw-card-icon"><Clock size={15} /></span>
    <h3 class="kw-card-title">最近更新</h3>
    <a class="kw-card-more" href="#all-notes" aria-label="查看全部最近更新">
      查看全部
      <ChevronRight size={12} aria-hidden="true" />
    </a>
  </div>

  <ul class="kw-recent-list">
    {recent.map((note) => (
      <li>
        <a class="kw-recent-item" href={note.href} data-note-id={note.id}>
          <div class="kw-recent-body">
            <p class="kw-recent-title">{note.title}</p>
            <div class="kw-recent-meta">
              <span class="kw-recent-time">{note.time}</span>
              <span class:list={['kw-recent-tag', accentColorMap[note.categoryColor] || 'kw-tag-slate']}>{note.category}</span>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .kw-recent-card {
    display: flex;
    flex-direction: column;
  }

  .kw-recent-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  .kw-recent-list li + li {
    margin-top: 4px;
  }

  .kw-recent-item {
    display: block;
    padding: 9px 10px;
    border-radius: 10px;
    transition: background 0.12s;
  }

  .kw-recent-item:hover {
    background: color-mix(in oklab, var(--kb-accent) 6%, transparent);
  }

  .kw-recent-body {
    min-width: 0;
  }

  .kw-recent-title {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--kb-text);
    line-height: 1.45;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: color 0.12s;
  }

  .kw-recent-item:hover .kw-recent-title {
    color: var(--kb-heading);
  }

  .kw-recent-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .kw-recent-time {
    font-size: 0.66rem;
    color: var(--kb-subtle);
    font-variant-numeric: tabular-nums;
  }

  .kw-recent-tag {
    display: inline-flex;
    align-items: center;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 0.64rem;
    font-weight: 500;
  }

  .kw-tag-orange {
    background: color-mix(in oklab, var(--kb-accent) 14%, transparent);
    color: var(--kb-accent);
  }
  .kw-tag-green {
    background: color-mix(in oklab, var(--kb-success) 16%, transparent);
    color: var(--kb-success);
  }
  .kw-tag-blue {
    background: color-mix(in oklab, var(--kb-accent-2) 16%, transparent);
    color: var(--kb-accent-2);
  }
  .kw-tag-amber {
    background: color-mix(in oklab, var(--kb-warning) 18%, transparent);
    color: var(--kb-warning);
  }
  .kw-tag-slate {
    background: var(--kb-surface-hover);
    color: var(--kb-muted);
  }
</style>
