---
import { ScrollText, RefreshCw } from '@lucide/astro';
---

<section class="admin-view" data-view="logs">
  <div class="admin-page-head">
    <div class="title-block">
      <h2>操作日志</h2>
      <p>后台所有写操作（新建/更新/删除笔记、上传/删除图片）的记录。</p>
    </div>
    <div class="admin-page-actions">
      <button class="admin-btn secondary" type="button" id="logs-refresh-btn">
        <RefreshCw size={15} aria-hidden="true" />
        刷新
      </button>
    </div>
  </div>

  <!-- 消息条 -->
  <div id="logs-message"></div>

  <!-- 统计条（紧凑） -->
  <div class="logs-stats" id="logs-stats">
    <div class="logs-stat">
      <span class="logs-stat-icon"><ScrollText size={16} /></span>
      <span class="logs-stat-body">
        <span class="logs-stat-label">日志总数</span>
        <span class="logs-stat-value" data-log-stat="total">—</span>
      </span>
    </div>
    <div class="logs-stat">
      <span class="logs-stat-icon logs-stat-create">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      </span>
      <span class="logs-stat-body">
        <span class="logs-stat-label">笔记新建</span>
        <span class="logs-stat-value" data-log-stat="note.create">—</span>
      </span>
    </div>
    <div class="logs-stat">
      <span class="logs-stat-icon logs-stat-update">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M11 13h6"></path><path d="M11 17h3"></path></svg>
      </span>
      <span class="logs-stat-body">
        <span class="logs-stat-label">笔记更新</span>
        <span class="logs-stat-value" data-log-stat="note.update">—</span>
      </span>
    </div>
    <div class="logs-stat">
      <span class="logs-stat-icon logs-stat-image">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
      </span>
      <span class="logs-stat-body">
        <span class="logs-stat-label">图片操作</span>
        <span class="logs-stat-value" data-log-stat="image">—</span>
      </span>
    </div>
    <div class="logs-stat">
      <span class="logs-stat-icon logs-stat-delete">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
      </span>
      <span class="logs-stat-body">
        <span class="logs-stat-label">删除笔记</span>
        <span class="logs-stat-value" data-log-stat="note.delete">—</span>
      </span>
    </div>
  </div>

  <!-- 工具栏：搜索 + 类型筛选 + 操作者 -->
  <div class="logs-toolbar">
    <div class="admin-search">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
      <input id="logs-search" class="admin-input" type="search" placeholder="搜索标题 / 路径 / 操作者..." />
    </div>
    <select id="logs-actor-filter" class="admin-input logs-actor-select">
      <option value="">全部操作者</option>
    </select>
    <div class="admin-filter-group" id="logs-action-filter">
      <button type="button" class="admin-chip is-active" data-log-filter="all">全部</button>
      <button type="button" class="admin-chip" data-log-filter="note.create">新建笔记</button>
      <button type="button" class="admin-chip" data-log-filter="note.update">更新笔记</button>
      <button type="button" class="admin-chip" data-log-filter="note.delete">删除笔记</button>
      <button type="button" class="admin-chip" data-log-filter="image.upload">上传图片</button>
      <button type="button" class="admin-chip" data-log-filter="image.delete">删除图片</button>
    </div>
    <span id="logs-count" class="admin-text-xs admin-subtle admin-mono">—</span>
  </div>

  <!-- 日志表格 -->
  <div class="admin-table-wrap logs-table-wrap">
    <table class="admin-table logs-table">
      <thead>
        <tr>
          <th class="logs-col-object">操作对象</th>
          <th class="logs-col-type">操作类型</th>
          <th class="logs-col-actor">操作人</th>
          <th class="logs-col-time">操作时间</th>
          <th class="logs-col-detail">操作详情</th>
        </tr>
      </thead>
      <tbody id="logs-tbody">
        <tr>
          <td colspan="5"><div class="admin-loading">正在加载日志...</div></td>
        </tr>
      </tbody>
    </table>
    <div class="logs-pagination admin-hidden" id="logs-pagination">
      <span class="logs-page-info" id="logs-page-info"></span>
      <div class="logs-page-btns" id="logs-page-btns"></div>
    </div>
  </div>
</section>
