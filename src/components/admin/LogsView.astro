---
import { ScrollText, RefreshCw } from '@lucide/astro';
---

<section class="admin-view" data-view="logs">
  <div class="admin-page-head">
    <div class="title-block">
      <h2>操作日志</h2>
      <p>后台所有写操作（新建/更新笔记、上传/删除图片）的时间线。</p>
    </div>
    <div class="admin-page-actions">
      <button class="admin-btn secondary" type="button" id="logs-refresh-btn">
        <RefreshCw size={15} aria-hidden="true" />
        刷新
      </button>
    </div>
  </div>

  <!-- 消息条 -->
  <div id="logs-message"></div>

  <!-- 统计卡片 -->
  <div class="logs-stats-grid" id="logs-stats">
    <div class="logs-stat-card">
      <div class="logs-stat-icon"><ScrollText size={18} /></div>
      <div class="logs-stat-body">
        <div class="logs-stat-label">日志总数</div>
        <div class="logs-stat-value" data-log-stat="total">—</div>
      </div>
    </div>
    <div class="logs-stat-card">
      <div class="logs-stat-icon logs-stat-create">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      </div>
      <div class="logs-stat-body">
        <div class="logs-stat-label">笔记新建</div>
        <div class="logs-stat-value" data-log-stat="note.create">—</div>
      </div>
    </div>
    <div class="logs-stat-card">
      <div class="logs-stat-icon logs-stat-update">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M11 13h6"></path><path d="M11 17h3"></path></svg>
      </div>
      <div class="logs-stat-body">
        <div class="logs-stat-label">笔记更新</div>
        <div class="logs-stat-value" data-log-stat="note.update">—</div>
      </div>
    </div>
    <div class="logs-stat-card">
      <div class="logs-stat-icon logs-stat-image">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
      </div>
      <div class="logs-stat-body">
        <div class="logs-stat-label">图片操作</div>
        <div class="logs-stat-value" data-log-stat="image">—</div>
      </div>
    </div>
  </div>

  <!-- 工具栏 -->
  <div class="admin-toolbar">
    <div class="admin-search">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
      <input id="logs-search" class="admin-input" type="search" placeholder="搜索目标/标题/操作者..." />
    </div>
    <div class="admin-filter-group" id="logs-action-filter">
      <button type="button" class="admin-chip is-active" data-log-filter="all">全部</button>
      <button type="button" class="admin-chip" data-log-filter="note.create">新建笔记</button>
      <button type="button" class="admin-chip" data-log-filter="note.update">更新笔记</button>
      <button type="button" class="admin-chip" data-log-filter="image.upload">上传图片</button>
      <button type="button" class="admin-chip" data-log-filter="image.delete">删除图片</button>
    </div>
    <span id="logs-count" class="admin-text-xs admin-subtle admin-mono" style="margin-left:auto">—</span>
  </div>

  <!-- 时间线 -->
  <div class="logs-timeline" id="logs-timeline">
    <div class="admin-loading">正在加载日志...</div>
  </div>
</section>

<style>
  .logs-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 18px;
  }

  .logs-stat-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--kb-border);
    border-radius: var(--admin-radius);
    background: var(--kb-surface);
  }

  .logs-stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--kb-accent-soft);
    color: var(--kb-accent);
    flex-shrink: 0;
  }

  .logs-stat-create .logs-stat-icon,
  .logs-stat-icon.logs-stat-create {
    background: color-mix(in oklab, var(--kb-success) 16%, transparent);
    color: var(--kb-success);
  }

  .logs-stat-icon.logs-stat-update {
    background: color-mix(in oklab, var(--kb-accent-2) 16%, transparent);
    color: var(--kb-accent-2);
  }

  .logs-stat-icon.logs-stat-image {
    background: color-mix(in oklab, var(--kb-accent) 16%, transparent);
    color: var(--kb-accent);
  }

  .logs-stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--kb-subtle);
    text-transform: uppercase;
  }

  .logs-stat-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--kb-heading);
    line-height: 1.2;
    margin-top: 2px;
  }

  /* 时间线 */
  .logs-timeline {
    position: relative;
    padding-left: 24px;
  }

  .logs-timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--kb-border);
    border-radius: 1px;
  }

  .logs-empty {
    padding: 48px 20px;
    text-align: center;
    color: var(--kb-muted);
    font-size: 0.9rem;
  }

  .log-item {
    position: relative;
    padding: 12px 14px;
    border: 1px solid var(--kb-border);
    border-radius: var(--admin-radius-sm);
    background: var(--kb-surface);
    margin-bottom: 10px;
    transition: border-color 0.12s, transform 0.12s;
  }

  .log-item:hover {
    border-color: var(--kb-border-strong);
    transform: translateX(2px);
  }

  .log-item::before {
    content: '';
    position: absolute;
    left: -22px;
    top: 16px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--kb-surface);
    border: 2px solid var(--kb-accent);
    box-shadow: 0 0 0 3px var(--kb-bg);
  }

  .log-item.log-create::before { border-color: var(--kb-success); }
  .log-item.log-update::before { border-color: var(--kb-accent-2); }
  .log-item.log-image::before { border-color: var(--kb-accent); }
  .log-item.log-delete::before { border-color: var(--kb-danger); }

  .log-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 4px;
  }

  .log-action-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--kb-surface-hover);
    color: var(--kb-muted);
  }

  .log-action-badge.log-create {
    background: color-mix(in oklab, var(--kb-success) 16%, transparent);
    color: var(--kb-success);
  }

  .log-action-badge.log-update {
    background: color-mix(in oklab, var(--kb-accent-2) 16%, transparent);
    color: var(--kb-accent-2);
  }

  .log-action-badge.log-image {
    background: color-mix(in oklab, var(--kb-accent) 16%, transparent);
    color: var(--kb-accent);
  }

  .log-action-badge.log-delete {
    background: color-mix(in oklab, var(--kb-danger) 16%, transparent);
    color: var(--kb-danger);
  }

  .log-time {
    font-size: 0.78rem;
    color: var(--kb-subtle);
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .log-actor {
    font-size: 0.78rem;
    color: var(--kb-muted);
    margin-left: auto;
  }

  .log-title {
    font-size: 0.9rem;
    color: var(--kb-text);
    font-weight: 500;
    margin: 4px 0;
    word-break: break-all;
  }

  .log-target {
    font-size: 0.74rem;
    color: var(--kb-subtle);
    font-family: var(--font-mono, ui-monospace, monospace);
    word-break: break-all;
  }

  .log-commit {
    font-size: 0.7rem;
    color: var(--kb-disabled);
    font-family: var(--font-mono, ui-monospace, monospace);
    margin-top: 2px;
  }
</style>
